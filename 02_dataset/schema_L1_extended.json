      "temperature_min_c": {"L1": true, "type": "float", "default": -10},
      "temperature_max_c": {"L1": true, "type": "float", "default": 35},
      "temperature_extreme_min_c": {"L2": true, "type": "float", "default": -40, "note": "Для северных объектов до -47°C (СТО Газпром Ямал)."},
