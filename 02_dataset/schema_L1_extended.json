      "Q_peak_duration_min": {"L1": true, "type": "int", "unit": "мин", "default": null},
      "Q_lpm": {"L0": true, "type": "float", "unit": "л/мин", "alt_unit_for": "Q_m3h", "note": "Альтернативный ввод. См. кейс 4 КНС с измельчителем — клиент написал 'л/м'."},
      "Q_avg_l_s": {"L1": true, "type": "float", "unit": "л/с", "default": null, "note": "Средний расход (для расчётов годового объёма)."},
      "dH_m": {"L0": true, "type": "float", "unit": "м", "default": 5, "note": "Полный требуемый напор насоса"},
