      "code_ownership": {"L2": true, "type": "enum", "values": ["closed", "open_source_with_comments"], "default": "closed", "note": "Газпром требует исходный код ПЛК с комментариями."},
      "signal_protocol_kip": {"L2": true, "type": "enum", "values": ["digital_only", "4-20mA", "4-20mA_HART", "Profibus", "Profinet"], "default": "4-20mA"}
