      "ladder_material": {"L1": true, "type": "enum", "values": ["StZn", "AISI304", "AISI316", "стеклопластик"], "default": "StZn"},
      "ladder_platform_required": {"L1": true, "type": "bool", "default": false, "note": "Промежуточная площадка через 6 м (СП 12-04-2002). Если корпус >9 м."},
      "anchor_points_for_height_work": {"L1": true, "type": "bool", "default": false},
      "trash_basket_material": {"L1": true, "type": "enum", "values": ["AISI304", "AISI316", "Ст3", "ПП"], "default": "AISI304"}
    },
