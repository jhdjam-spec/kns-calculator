      "D_pressure_user_mm": {"L1": true, "type": "float", "unit": "мм", "default": null, "note": "Заказчик указал диаметр напорной трубы"},
      "pipe_material": {"L1": true, "type": "enum", "values": ["ПЭ100_SDR17", "Polycorr", "КОРСИС", "HOBAS", "ВЧШГ_PN16", "сталь", "AISI304", "ПВХ"], "default": "ПЭ100_SDR17"},
      "regime": {"L1": true, "type": "enum", "values": ["continuous_24_7", "shift", "impulse", "seasonal"], "default": "continuous_24_7", "note": "Источник: ЮМИ Групп бриф, Симферополь склад 'порционный сброс'."}
    },
