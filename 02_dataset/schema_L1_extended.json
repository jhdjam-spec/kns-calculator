  "validations": [
    {
      "id": "V1_velocity",
      "rule": "Q / A_pipe_internal >= 1.0 m/s",
      "severity": "warning_critical",
      "message": "Скорость в напорной трубе ниже самоочищающейся. Труба заилится за 6-12 месяцев.",
      "action_options": [
        "Увеличить Q до Q_min(D) = 12.6 м³/ч для текущего D",
        "Уменьшить D до D_max(Q) = 50 мм"
      ],
      "source": "СП 32.13330 §5.4 + Терра-Н КНС-2/3 (письмо инженера)"
    },
    {
      "id": "V2_energy_paradox",
      "rule": "dH_m > dz_geodetic_m",
      "severity": "error_block_calculation",
      "message": "Энергетический парадокс — H насоса (X м) меньше геодезической разницы высот (Y м). Вода не дойдёт до конца трубы.",
      "source": "Терра-Н КНС-3 (H=5 < Δz=5,6)"
    },
    {
      "id": "V3_head_deficit",
      "rule": "dH_m >= dz_geodetic_m + safe_friction(L,D,Q) + H_residual_min",
      "severity": "warning",
      "message": "Дефицит напора N м, расчётный минимум M м.",
      "source": "Bernoulli equation"
    },
    {
      "id": "V4_BEP_proximity",
      "rule": "0.5 <= Q_design / Q_BEP <= 1.2",
      "severity": "warning",
      "message": "Q вне зоны эффективности (за пределами 50%-120% Q_BEP). Рециркуляция/износ.",
      "source": "ISO9906 + Phase 8.5 §15"
    },
    {
      "id": "V5_wastewater_material",
      "rule": "Если wastewater_type=landfill_leachate или industrial_oily — фильтровать насосы по material_compat: SiC/SiC уплотнение, нерж 316L или дуплекс",
      "severity": "filter",
      "message": "Для агрессивных стоков (фильтрат ТКО/нефтесодержащие) обычные чугунные не подходят.",
      "source": "Терра-Н фильтрат + Промливневка ATEX"
    },
    {
      "id": "V6_atex_filter",
      "rule": "Если atex_required=true — оставлять только насосы с available_ru.atex_class != null",
      "severity": "filter",
      "source": "Промливневка Q=132 ATEX"
    },
    {
      "id": "V7_power_limit",
      "rule": "Если installed_power_limit_kw указан — фильтровать насосы по P_kW × n_рабочих <= лимит",
      "severity": "filter",
      "message": "Превышен лимит установленной мощности от ТУ.",
      "source": "Экотехнопарк Крым (КНС фильтрат лимит 5 кВт)"
    },
    {
      "id": "V8_ladder_safety",
      "rule": "Если corpus_height_m > 6 — требуется промежуточная площадка",
      "severity": "advisory",
      "message": "СП 12-04-2002 требует промежуточную площадку лестницы через 6 м.",
      "source": "Терра-Н КНС-2 (L=11 м без площадки)"
    }
  ]
}
